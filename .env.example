# ===========================================
# EliteShop Colombia Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ===========================================
# SPRING PROFILES
# ===========================================
# Available profiles: local, dev, prod
SPRING_PROFILES_ACTIVE=local

# ===========================================
# CONFIG SERVER (Spring Cloud Config)
# ===========================================
# URI of the Spring Cloud Config Server
CONFIG_SERVER_URI=http://localhost:8888

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# These properties are served by Config Server in dev/prod.
# For local development without Config Server, set them here.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/eliteshop
SPRING_DATASOURCE_USERNAME=eliteshop
SPRING_DATASOURCE_PASSWORD=your_database_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_LIQUIBASE_ENABLED=true

# ===========================================
# JWT (JSON Web Token)
# ===========================================
# Secret key for JWT signing (Base64-encoded, minimum 32 bytes)
JWT_SECRET=your_base64_encoded_secret_key_here
# Token expiration in milliseconds (default: 24 hours = 86400000)
JWT_EXPIRATION=86400000
# Token issuer
JWT_ISSUER=eliteshop-backend

# ===========================================
# MINIO (Object Storage)
# ===========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
# Bucket names for different storage needs
MINIO_BUCKET_VERIFICATION_SELLERS=verification-sellers
MINIO_BUCKET_PRODUCT_IMAGES=product-images
MINIO_BUCKET_REVIEW_IMAGES=review-images
MINIO_BUCKET_CUSTOMER_AVATARS=customer-avatars
MINIO_BUCKET_BUSINESS_AVATARS=business-avatars

# ===========================================
# EPAYCO (Payment Gateway)
# ===========================================
PAYMENTS_EPAYCO_PUBLIC_KEY=your_epayco_public_key
PAYMENTS_EPAYCO_PRIVATE_KEY=your_epayco_private_key
PAYMENTS_EPAYCO_APIFY_BASE_URL=https://api.epayco.co
PAYMENTS_EPAYCO_ENVIRONMENT=production

# ===========================================
# FACE MATCHER (Identity Verification)
# ===========================================
FACE_MATCHER_URL=http://localhost:8081

# ===========================================
# GATEWAY (API Gateway)
# ===========================================
GATEWAY_URL=http://localhost:3000
GATEWAY_SECRET=your_webhook_secret_for_gateway

# ===========================================
# GITHUB WEBHOOKS
# ===========================================
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_WEBHOOK_ENABLED=false

# ===========================================
# SLACK NOTIFICATIONS
# ===========================================
SLACK_ENABLED=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ===========================================
# MAIL (SMTP)
# ===========================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# ===========================================
# ACTUATOR
# ===========================================
# Management endpoints exposure (default: health,info)
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=*
